{
  "manifest_version": 3,
  "name": "Hide Shorts for YouTube",
  "version": "1.1.0",
  "description": "Removes Shorts videos, shelves and menu entries from YouTube and opens Shorts links in the regular video player.",
  "icons": {
    "48": "icon.svg",
    "96": "icon.svg"
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*", "*://m.youtube.com/*"],
      "css": ["hide-shorts.css"],
      "js": ["redirect-shorts.js"],
      "run_at": "document_start"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "piilota-shorts@local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
